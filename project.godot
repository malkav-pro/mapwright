; Engine configuration file.
; Mapwright Phase 0 prototype.

config_version=5

[application]

config/name="Malkav's Mapwright"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://Assets/logo-icon.png"
boot_splash/bg_color=Color(0.035, 0.043, 0.047, 1)

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Mapwright"

[rendering]

environment/defaults/default_clear_color=Color(0.035, 0.043, 0.047, 1)
