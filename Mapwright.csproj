<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Mapwright</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tools/**/*.cs" />
    <Compile Remove="src/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src\Mapwright.Domain\Mapwright.Domain.csproj" />
    <ProjectReference Include="src\Mapwright.Application\Mapwright.Application.csproj" />
    <ProjectReference Include="src\Mapwright.Infrastructure\Mapwright.Infrastructure.csproj" />
  </ItemGroup>
</Project>
